@page "/patient/appointments"
@attribute [Authorize(Roles = "Patient")]
@layout QPharmacy.Shared.Layout.MainLayout
@using QPharmacy.Services
@using QPharmacy.Shared.Models.Database
@using Blazicons
@inject IPatientService PatientService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Appointments - QPharmacy</PageTitle>

<div class="max-w-7xl mx-auto space-y-6 pb-12">
    <!-- Success / Info Toast -->
    @if (!string.IsNullOrEmpty(toastMessage))
    {
        <div class="fixed top-6 right-6 z-50 bg-emerald-600 text-white px-4 py-3 rounded-lg shadow-lg flex items-center justify-between space-x-4 animate-in fade-in slide-in-from-top-4 duration-300">
            <div class="flex items-center space-x-2">
                <Blazicon Svg="Lucide.Check" class="w-5 h-5 text-white" />
                <span class="text-sm font-medium">@toastMessage</span>
            </div>
            <button @onclick="() => toastMessage = null" class="text-white hover:text-emerald-100 transition-colors">
            <Blazicon Svg="Lucide.X" class="w-4 h-4" />
        </button>
    </div>
}

<!-- Page Header -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Appointments &amp; Telehealth</h1>
        <p class="text-sm text-slate-500 mt-0.5">Schedule consultations with your healthcare providers and join live telehealth rooms.</p>
    </div>
    <div class="flex items-center space-x-3">
        <button @onclick="OpenBookingModal" class="bg-brand-dark hover:bg-brand-DEFAULT text-white px-4 py-2 rounded-lg font-medium shadow-sm transition-colors text-sm flex items-center space-x-2 cursor-pointer">
            <Blazicon Svg="Lucide.Plus" class="w-4 h-4" />
            <span>Book Appointment</span>
        </button>
    </div>
</div>

<!-- Active / Next Appointment Spotlight Banner -->
@if (nextAppointment != null)
{
    <div class="bg-gradient-to-r from-teal-900 via-teal-800 to-slate-900 text-white rounded-2xl p-6 shadow-md border border-teal-800/40 relative overflow-hidden">
        <div class="absolute -right-8 -bottom-8 w-44 h-44 bg-teal-500/10 rounded-full blur-2xl pointer-events-none"></div>
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
            <div class="space-y-2">
                <div class="flex items-center space-x-2">
                    <span class="bg-teal-500/20 text-teal-200 border border-teal-400/30 text-xs font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                        Upcoming Consultation
                    </span>
                    <span class="text-xs text-teal-300 font-medium">&bull; @nextAppointment.Mode Telehealth</span>
                </div>
                <div class="flex items-center space-x-3 pt-1">
                    <div class="w-11 h-11 rounded-xl bg-teal-700/60 border border-teal-500/40 flex items-center justify-center font-bold text-sm text-teal-100 shadow-sm shrink-0">
                        @GetDoctorInitials(nextAppointment.DoctorName)
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-white leading-tight">@nextAppointment.DoctorName</h2>
                        <p class="text-xs text-teal-200/90">@nextAppointment.Specialty &bull; @(string.IsNullOrWhiteSpace(nextAppointment.Notes) ? "Routine Consultation" : nextAppointment.Notes)</p>
                    </div>
                </div>
                <div class="flex items-center space-x-4 text-xs text-slate-300 pt-1">
                    <span class="flex items-center space-x-1.5 bg-slate-800/60 border border-slate-700/50 px-2.5 py-1 rounded-lg">
                        <Blazicon Svg="Lucide.Calendar" class="w-3.5 h-3.5 text-teal-400" />
                        <span>@nextAppointment.AppointmentDate.ToString("dddd, dd MMM yyyy")</span>
                    </span>
                    <span class="flex items-center space-x-1.5 bg-slate-800/60 border border-slate-700/50 px-2.5 py-1 rounded-lg">
                        <Blazicon Svg="Lucide.Clock" class="w-3.5 h-3.5 text-teal-400" />
                        <span>@nextAppointment.AppointmentDate.ToString("HH:mm")</span>
                    </span>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2.5">
                @if (nextAppointment.Mode == "Video" && nextAppointment.Status != "Cancelled")
                {
                    @if (nextAppointment.Status == "WaitingInLobby")
                    {
                        <button disabled class="bg-amber-500/20 border border-amber-500/40 text-amber-300 text-xs font-semibold px-4 py-2.5 rounded-xl flex items-center space-x-2 cursor-not-allowed">
                            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                            <span>Waiting for Doctor...</span>
                        </button>
                    }
                    else if (nextAppointment.Status == "InProgress")
                    {
                        <button @onclick="() => JoinConsultation(nextAppointment.Id)" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-md transition-all flex items-center space-x-2 cursor-pointer animate-pulse">
                            <Blazicon Svg="Lucide.Video" class="w-4 h-4" />
                            <span>In Consultation (Join)</span>
                        </button>
                    }
                    else if (nextAppointment.Status != "Completed")
                    {
                        <button @onclick="() => JoinConsultation(nextAppointment.Id)" class="bg-teal-500 hover:bg-teal-400 text-slate-950 text-xs font-bold px-4 py-2.5 rounded-xl shadow-md transition-all flex items-center space-x-2 cursor-pointer">
                            <Blazicon Svg="Lucide.Video" class="w-4 h-4 text-slate-950" />
                            <span>Join Video Room</span>
                        </button>
                    }
                }
            @if (nextAppointment.Status != "Cancelled")
            {
                <button @onclick="() => CancelAppointment(nextAppointment.Id)" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white text-xs font-medium px-3.5 py-2.5 rounded-xl transition-colors cursor-pointer">
                <span>Cancel</span>
            </button>
        }
    </div>
</div>
</div>
}

<!-- Appointments History / Management Section -->
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
    <!-- Table Search & Filter Bar -->
    <div class="p-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-50/40">
        <!-- Search Bar -->
        <div class="relative w-full sm:w-80">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <Blazicon Svg="Lucide.Search" class="w-4 h-4" />
            </div>
            <input type="text"
            @bind="searchTerm"
            @bind:event="oninput"
            placeholder="Search doctor, specialty, reason..."
            class="w-full pl-9 pr-4 py-2 bg-white border border-slate-200 rounded-xl text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 transition-all shadow-2xs" />
        </div>

        <!-- Filter Tabs -->
        <div class="flex items-center space-x-1 bg-slate-200/70 p-1 rounded-xl">
            <button @onclick="@(() => activeTab = "All")" class="px-3 py-1.5 text-xs font-medium rounded-lg transition-all cursor-pointer @(activeTab == "All" ? "bg-white text-slate-900 shadow-xs font-bold" : "text-slate-600 hover:text-slate-900")">
            All (@appointments.Count)
        </button>
        <button @onclick="@(() => activeTab = "Upcoming")" class="px-3 py-1.5 text-xs font-medium rounded-lg transition-all cursor-pointer @(activeTab == "Upcoming" ? "bg-white text-slate-900 shadow-xs font-bold" : "text-slate-600 hover:text-slate-900")">
        Upcoming (@appointments.Count(a => a.AppointmentDate >= DateTime.Now && a.Status != "Cancelled"))
    </button>
    <button @onclick="@(() => activeTab = "Completed")" class="px-3 py-1.5 text-xs font-medium rounded-lg transition-all cursor-pointer @(activeTab == "Completed" ? "bg-white text-slate-900 shadow-xs font-bold" : "text-slate-600 hover:text-slate-900")">
    Completed (@appointments.Count(a => a.Status == "Completed"))
</button>
<button @onclick="@(() => activeTab = "Cancelled")" class="px-3 py-1.5 text-xs font-medium rounded-lg transition-all cursor-pointer @(activeTab == "Cancelled" ? "bg-white text-slate-900 shadow-xs font-bold" : "text-slate-600 hover:text-slate-900")">
Cancelled (@appointments.Count(a => a.Status == "Cancelled"))
</button>
</div>
</div>

<!-- Sleek Appointments Table -->
<div class="overflow-x-auto">
    <table class="w-full text-left text-sm text-slate-600 border-collapse min-w-[850px]">
        <thead class="bg-slate-50/75 text-xs font-semibold text-slate-400 uppercase tracking-wider border-b border-slate-200">
            <tr>
                <th class="px-5 py-3.5 whitespace-nowrap">Healthcare Provider</th>
                <th class="px-4 py-3.5 whitespace-nowrap">Specialty</th>
                <th class="px-4 py-3.5 whitespace-nowrap">Date &amp; Time</th>
                <th class="px-4 py-3.5 whitespace-nowrap">Clinical Reason</th>
                <th class="px-4 py-3.5 whitespace-nowrap">Status</th>
                <th class="px-5 py-3.5 text-right whitespace-nowrap">Action</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-xs">
            @if (FilteredAppointments.Any())
            {
                @foreach (var appt in FilteredAppointments)
                {
                    <tr class="hover:bg-slate-50/80 transition-colors whitespace-nowrap">
                        <td class="px-5 py-3.5">
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 rounded-xl bg-teal-100 text-teal-800 font-bold text-xs flex items-center justify-center shrink-0 shadow-2xs">
                                    @GetDoctorInitials(appt.DoctorName)
                                </div>
                                <div>
                                    <span class="font-bold text-slate-900 text-xs block">@appt.DoctorName</span>
                                    <span class="text-xs text-slate-400">Licensed Physician</span>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-3.5">
                            <span class="text-xs font-medium text-slate-700 bg-slate-100 px-2 py-0.5 rounded-md border border-slate-200/50 inline-block">
                                @appt.Specialty
                            </span>
                        </td>
                        <td class="px-4 py-3.5">
                            <div>
                                <span class="font-semibold text-slate-800 text-xs block">@appt.AppointmentDate.ToString("ddd, dd MMM yyyy")</span>
                                <span class="font-mono text-xs text-teal-700 bg-teal-50 px-1.5 py-0.5 rounded border border-teal-200/50 inline-block mt-0.5">
                                    @appt.AppointmentDate.ToString("HH:mm")
                                </span>
                            </div>
                        </td>
                       
                        <td class="px-4 py-3.5 text-slate-600 max-w-xs truncate">
                            @(string.IsNullOrWhiteSpace(appt.Notes) ? "Routine Consultation" : appt.Notes)
                        </td>
                        <td class="px-4 py-3.5">
                            @switch (appt.Status)
                            {
                                case "WaitingInLobby":
                                <span class="bg-amber-50 text-amber-800 border border-amber-200/70 px-2.5 py-1 rounded-full text-xs font-semibold inline-flex items-center space-x-1.5 shadow-2xs">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                    <span>Waiting in Lobby</span>
                                </span>
                                break;
                                case "Confirmed":
                                case "Scheduled":
                                <span class="bg-emerald-50 text-emerald-800 border border-emerald-200/70 px-2.5 py-1 rounded-full text-xs font-semibold inline-flex items-center space-x-1.5 shadow-2xs">
                                    <Blazicon Svg="Lucide.Check" class="w-3.5 h-3.5 text-emerald-600" />
                                    <span>Scheduled</span>
                                </span>
                                break;
                                case "Completed":
                                <span class="bg-blue-50 text-blue-800 border border-blue-200/70 px-2.5 py-1 rounded-full text-xs font-semibold inline-flex items-center space-x-1.5 shadow-2xs">
                                    <Blazicon Svg="Lucide.Check" class="w-3.5 h-3.5 text-blue-600" />
                                    <span>Completed</span>
                                </span>
                                break;
                                case "Cancelled":
                                <span class="bg-rose-50 text-rose-800 border border-rose-200/70 px-2.5 py-1 rounded-full text-xs font-semibold inline-flex items-center space-x-1.5 shadow-2xs">
                                    <Blazicon Svg="Lucide.X" class="w-3.5 h-3.5 text-rose-600" />
                                    <span>Cancelled</span>
                                </span>
                                break;
                                default:
                                <span class="bg-slate-100 text-slate-700 border border-slate-200 px-2.5 py-1 rounded-full text-xs font-semibold inline-block">
                                    @appt.Status
                                </span>
                                break;
                            }
                        </td>
                        <td class="px-5 py-3.5 text-right">
                            <div class="flex items-center justify-end space-x-2">
                                @if (appt.Mode == "Video" && appt.Status != "Cancelled")
                                {
                                    @if (appt.Status == "WaitingInLobby")
                                    {
                                        <button disabled class="bg-amber-50 border border-amber-200 text-amber-700 font-semibold text-xs px-3 py-1.5 rounded-lg flex items-center space-x-1.5 cursor-not-allowed shadow-2xs">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                            <span>Waiting for Doctor...</span>
                                        </button>
                                    }
                                    else if (appt.Status == "InProgress")
                                    {
                                        <button @onclick="() => JoinConsultation(appt.Id)" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs px-3.5 py-1.5 rounded-lg shadow-xs transition-colors flex items-center space-x-1.5 cursor-pointer animate-pulse">
                                            <Blazicon Svg="Lucide.Video" class="w-3.5 h-3.5" />
                                            <span>Join Call</span>
                                        </button>
                                    }
                                    else if (appt.Status != "Completed")
                                    {
                                        <button @onclick="() => JoinConsultation(appt.Id)" class="bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs px-3.5 py-1.5 rounded-lg shadow-xs transition-colors flex items-center space-x-1.5 cursor-pointer">
                                            <Blazicon Svg="Lucide.Video" class="w-3.5 h-3.5" />
                                            <span>Join Lobby</span>
                                        </button>
                                    }
                                }
                            @if (appt.Status != "Cancelled" && appt.Status != "Completed")
                            {
                                <button @onclick="() => CancelAppointment(appt.Id)" class="text-slate-400 hover:text-rose-600 hover:bg-rose-50 p-1.5 rounded-lg transition-colors cursor-pointer" title="Cancel Appointment">
                                <Blazicon Svg="Lucide.X" class="w-4 h-4" />
                            </button>
                        }
                    </div>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="7" class="px-6 py-12 text-center text-slate-400">
                <div class="flex flex-col items-center justify-center space-y-2">
                    <Blazicon Svg="Lucide.CalendarX" class="w-8 h-8 text-slate-300" />
                    <p class="font-bold text-slate-600 text-sm">No appointments found</p>
                    <p class="text-xs text-slate-400">Try adjusting your search criteria or switch to another tab.</p>
                </div>
            </td>
        </tr>
    }
</tbody>
</table>
</div>
</div>
</div>

<!-- Book Appointment Modal -->
@if (isBookingModalOpen)
{
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <!-- Modal Header -->
            <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                <div class="flex items-center space-x-2">
                    <div class="w-8 h-8 rounded-lg bg-teal-100 text-teal-700 flex items-center justify-center font-bold">
                        <Blazicon Svg="Lucide.Calendar" class="w-4 h-4" />
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-slate-900">Book New Appointment</h3>
                        <p class="text-xs text-slate-500">Select doctor, consultation mode, date and time</p>
                    </div>
                </div>
                <button @onclick="CloseBookingModal" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
                    <Blazicon Svg="Lucide.X" class="w-5 h-5" />
                </button>
            </div>

            <!-- Modal Form Body -->
            <div class="p-6 space-y-4 text-xs">
                <!-- Select Doctor -->
                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Select Healthcare Provider</label>
                    <select @bind="selectedDoctorIndex" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs bg-white focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-hidden">
                        @for (int i = 0; i < availableDoctors.Count; i++)
                        {
                            <option value="@i">@availableDoctors[i].Name — @availableDoctors[i].Specialty</option>
                        }
                    </select>
                </div>

                <!-- Consultation Mode -->
                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Consultation Mode</label>
                    <div class="grid grid-cols-2 gap-3">
                        <button type="button" @onclick="@(() => bookingMode = "Video")" class="p-3 border rounded-xl flex items-center space-x-2.5 text-left transition-all cursor-pointer @(bookingMode == "Video" ? "border-teal-600 bg-teal-50/50 text-teal-900 font-semibold" : "border-slate-200 hover:bg-slate-50 text-slate-700")">
                        <Blazicon Svg="Lucide.Video" class="@(bookingMode == "Video" ? "w-4 h-4 text-teal-600" : "w-4 h-4 text-slate-400")" />
                        <div>
                            <div class="text-xs">Video Call</div>
                            <div class="text-xs text-slate-500">Live Telehealth Lobby</div>
                        </div>
                    </button>
                    <button type="button" @onclick="@(() => bookingMode = "In-Person")" class="p-3 border rounded-xl flex items-center space-x-2.5 text-left transition-all cursor-pointer @(bookingMode == "In-Person" ? "border-teal-600 bg-teal-50/50 text-teal-900 font-semibold" : "border-slate-200 hover:bg-slate-50 text-slate-700")">
                    <Blazicon Svg="Lucide.Building" class="@(bookingMode == "In-Person" ? "w-4 h-4 text-teal-600" : "w-4 h-4 text-slate-400")" />
                    <div>
                        <div class="text-xs">In-Person</div>
                        <div class="text-xs text-slate-500">Clinic Visit</div>
                    </div>
                </button>
            </div>
        </div>

        <!-- Date & Time Row -->
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="block font-semibold text-slate-700 mb-1">Date</label>
                <input type="date" @bind="bookingDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs bg-white focus:ring-2 focus:ring-teal-500 outline-hidden" />
            </div>
            <div>
                <label class="block font-semibold text-slate-700 mb-1">Time Slot</label>
                <select @bind="bookingTime" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs bg-white focus:ring-2 focus:ring-teal-500 outline-hidden">
                    <option value="09:00">09:00 AM</option>
                    <option value="09:30">09:30 AM</option>
                    <option value="10:00">10:00 AM</option>
                    <option value="10:30">10:30 AM</option>
                    <option value="11:00">11:00 AM</option>
                    <option value="11:30">11:30 AM</option>
                    <option value="14:00">02:00 PM</option>
                    <option value="14:30">02:30 PM</option>
                    <option value="15:00">03:00 PM</option>
                    <option value="15:30">03:30 PM</option>
                </select>
            </div>
        </div>

        <!-- Clinical Reason / Notes -->
        <div>
            <label class="block font-semibold text-slate-700 mb-1">Reason for Visit / Symptoms</label>
            <textarea @bind="bookingNotes" rows="3" placeholder="e.g. Blood pressure follow-up, general review..." class="w-full border border-slate-300 rounded-lg p-2.5 text-xs bg-white focus:ring-2 focus:ring-teal-500 outline-hidden"></textarea>
        </div>
    </div>

    <!-- Modal Footer -->
    <div class="p-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end space-x-3">
        <button type="button" @onclick="CloseBookingModal" class="px-4 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-200/60 transition-colors cursor-pointer">
            Cancel
        </button>
        <button type="button" @onclick="SubmitBooking" class="px-5 py-2 rounded-lg text-xs font-semibold bg-brand-dark hover:bg-brand-DEFAULT text-white shadow-sm transition-colors cursor-pointer flex items-center space-x-1.5">
            <Blazicon Svg="Lucide.Check" class="w-4 h-4" />
            <span>Confirm Booking</span>
        </button>
    </div>
</div>
</div>
}

@code {
    private Guid currentPatientId = Guid.Empty;
    private string patientName = "Thandiwe Mokoena";
    private List<AppointmentModel> appointments = new();
    private AppointmentModel? nextAppointment;
    private string activeTab = "All";
    private string searchTerm = "";
    private string? toastMessage;

    // Booking Modal State
    private bool isBookingModalOpen = false;
    private int selectedDoctorIndex = 0;
    private string bookingMode = "Video";
    private DateTime bookingDate = DateTime.Today.AddDays(1);
    private string bookingTime = "09:30";
    private string bookingNotes = "";

    private record DoctorOption(Guid Id, string Name, string Specialty);
    private List<DoctorOption> availableDoctors = new()
    {
        new(Guid.Parse("5685B24E-0085-4DF9-91B1-6577322E90D7"), "Dr. Sarah Jenkins", "Cardiology"),
        new(Guid.Parse("88888888-8888-8888-8888-888888888888"), "Dr. Thabo Khumalo", "General Practice"),
        new(Guid.Parse("77777777-7777-7777-7777-777777777777"), "Dr. N. Adams", "Internal Medicine")
    };

    private string GetDoctorInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "DR";
        var cleaned = name.Replace("Dr.", "").Trim();
        var parts = cleaned.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "DR";
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private IEnumerable<AppointmentModel> FilteredAppointments
    {
        get
        {
            var list = activeTab switch
            {
                "Upcoming" => appointments.Where(a => a.Status != "Cancelled" && a.Status != "Completed"),
                "Completed" => appointments.Where(a => a.Status == "Completed"),
                "Cancelled" => appointments.Where(a => a.Status == "Cancelled"),
                _ => appointments
            };

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim().ToLowerInvariant();
                list = list.Where(a =>
                    (!string.IsNullOrEmpty(a.DoctorName) && a.DoctorName.ToLowerInvariant().Contains(term)) ||
                    (!string.IsNullOrEmpty(a.Specialty) && a.Specialty.ToLowerInvariant().Contains(term)) ||
                    (!string.IsNullOrEmpty(a.Notes) && a.Notes.ToLowerInvariant().Contains(term)));
            }

            return list;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var idClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (Guid.TryParse(idClaim, out var pid)) currentPatientId = pid;
            if (!string.IsNullOrWhiteSpace(user.Identity.Name)) patientName = user.Identity.Name;
        }

        await LoadAppointments();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var storedId = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "authUserId");
            if (Guid.TryParse(storedId, out var pid) && pid != Guid.Empty && pid != currentPatientId)
            {
                currentPatientId = pid;
                await LoadAppointments();
                StateHasChanged();
            }
        }
    }

    private async Task LoadAppointments()
    {
        var loaded = await PatientService.GetPatientAppointmentsAsync(currentPatientId);
        appointments = loaded.ToList();
        nextAppointment = await PatientService.GetNextAppointmentAsync(currentPatientId);
    }

    private void OpenBookingModal()
    {
        bookingDate = DateTime.Today.AddDays(1);
        bookingTime = "09:30";
        bookingNotes = "";
        bookingMode = "Video";
        isBookingModalOpen = true;
    }

    private void CloseBookingModal()
    {
        isBookingModalOpen = false;
    }

    private async Task SubmitBooking()
    {
        var doctor = availableDoctors[selectedDoctorIndex];
        var timeParts = bookingTime.Split(':');
        var apptDateTime = bookingDate.Date
            .AddHours(int.Parse(timeParts[0]))
            .AddMinutes(int.Parse(timeParts[1]));

        var newAppt = new AppointmentModel
        {
            Id = Guid.NewGuid(),
            PatientId = currentPatientId != Guid.Empty ? currentPatientId : Guid.Parse("A1B2C3D4-E5F6-7A8B-9C0D-1E2F3A4B5C6D"),
            DoctorId = doctor.Id,
            DoctorName = doctor.Name,
            Specialty = doctor.Specialty,
            AppointmentDate = apptDateTime,
            Mode = bookingMode,
            Status = "Confirmed",
            Notes = bookingNotes,
            CreatedAt = DateTime.UtcNow
        };

        try
        {
            var bookedId = await PatientService.BookAppointmentAsync(newAppt);
            isBookingModalOpen = false;
            toastMessage = $"Appointment booked with {doctor.Name} for {apptDateTime:MMM dd, HH:mm}!";
            await LoadAppointments();
        }
        catch (Exception ex)
        {
            toastMessage = $"Failed to book appointment: {ex.Message}";
        }
    }

    private async Task CancelAppointment(Guid appointmentId)
    {
        var success = await PatientService.CancelAppointmentAsync(appointmentId, currentPatientId);
        if (success)
        {
            toastMessage = "Appointment cancelled.";
            await LoadAppointments();
        }
    }

    private void JoinConsultation(Guid appointmentId)
    {
        Navigation.NavigateTo($"/patient/consultation?appointmentId={appointmentId}");
    }
}