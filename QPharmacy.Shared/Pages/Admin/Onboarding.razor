@page "/admin/onboarding"
@attribute [Authorize(Roles = "Admin")]
@using QPharmacy.Services
@using QPharmacy.Shared.Models.Database
@inject NavigationManager Navigation
@inject IAdminService AdminService

<div class="max-w-6xl mx-auto pb-12">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-6 gap-4">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900 tracking-tight">Onboarding</h1>
            <p class="text-sm text-slate-500 mt-1">Bring new pharmacies, doctors and drivers onto the platform.</p>
        </div>
    </div>

    <!-- Top-Right Floating Notification Toast Container -->
    <div class="fixed top-5 right-5 z-[100] max-w-sm sm:max-w-md w-full flex flex-col gap-3 pointer-events-none">
        @if (!string.IsNullOrEmpty(toastMessage))
        {
            <div class="pointer-events-auto p-4 rounded-xl flex items-center justify-between bg-emerald-50 text-emerald-900 border border-emerald-200 shadow-xl animate-fade-in transition-all">
                <div class="flex items-center space-x-3">
                    <Blazicon Svg="Lucide.Check" class="w-5 h-5 text-emerald-600 shrink-0" />
                    <span class="font-medium text-sm">@toastMessage</span>
                </div>
                <button @onclick="() => toastMessage = null" class="text-emerald-500 hover:text-emerald-700 transition-colors cursor-pointer shrink-0 ml-3">
                    <Blazicon Svg="Lucide.X" class="w-4 h-4" />
                </button>
            </div>
        }
    </div>

    @if (isLoading)
    {
        <div class="flex justify-center py-20">
            <svg class="animate-spin h-10 w-10 text-emerald-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
        </div>
    }
    else
    {
        <!-- Onboarding Pipeline Tabs (Pharmacies / Doctors / Drivers) -->
    <div class="border-b border-slate-200 mb-6">
        <div class="flex space-x-8">
            <button @onclick='() => SetTab("Pharmacies")' class="pb-3 text-sm font-semibold transition-colors border-b-2 cursor-pointer flex items-center space-x-2 @(selectedTab == "Pharmacies" ? "border-emerald-600 text-emerald-600" : "border-transparent text-slate-500 hover:text-slate-700")">
                <Blazicon Svg="Lucide.Store" class="w-4 h-4" />
                <span>Pharmacies (@pharmacyApplicants.Count)</span>
            </button>
            <button @onclick='() => SetTab("Doctors")' class="pb-3 text-sm font-semibold transition-colors border-b-2 cursor-pointer flex items-center space-x-2 @(selectedTab == "Doctors" ? "border-emerald-600 text-emerald-600" : "border-transparent text-slate-500 hover:text-slate-700")">
                <Blazicon Svg="Lucide.Stethoscope" class="w-4 h-4" />
                <span>Doctors (@doctorApplicants.Count)</span>
            </button>
            <button @onclick='() => SetTab("Drivers")' class="pb-3 text-sm font-semibold transition-colors border-b-2 cursor-pointer flex items-center space-x-2 @(selectedTab == "Drivers" ? "border-emerald-600 text-emerald-600" : "border-transparent text-slate-500 hover:text-slate-700")">
                <Blazicon Svg="Lucide.Truck" class="w-4 h-4" />
                <span>Drivers (@driverApplicants.Count)</span>
            </button>
        </div>
    </div>

    <!-- Applicant Table Card -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-white text-xs font-semibold text-slate-400 uppercase tracking-wider border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4">APPLICANT</th>
                        <th class="px-6 py-4">LOCATION</th>
                        <th class="px-6 py-4">SUBMITTED</th>
                        <th class="px-6 py-4">STATUS</th>
                        <th class="px-6 py-4 text-right">ACTION</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (CurrentTabApplicants == null || !CurrentTabApplicants.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-slate-400">
                                No applications found under @selectedTab category.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var applicant in CurrentTabApplicants)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4">
                                    <p class="font-semibold text-slate-900">@applicant.Name</p>
                                    <p class="text-xs text-slate-400 mt-0.5">@applicant.SubText</p>
                                </td>
                                <td class="px-6 py-4 text-slate-700 font-medium">@applicant.Location</td>
                                <td class="px-6 py-4 text-slate-500 font-medium">@applicant.SubmittedDate</td>
                                <td class="px-6 py-4">
                                    @if (applicant.Status == "Pending review")
                                    {
                                        <span class="bg-amber-50 text-amber-800 border border-amber-200/70 px-2.5 py-1 rounded-full text-xs font-semibold inline-flex items-center space-x-1.5">
                                            <Blazicon Svg="Lucide.Clock" class="w-3 h-3 text-amber-600 shrink-0" />
                                            <span>Pending review</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bg-emerald-50 text-emerald-800 border border-emerald-200/70 px-2.5 py-1 rounded-full text-xs font-semibold inline-flex items-center space-x-1.5">
                                            <Blazicon Svg="Lucide.Check" class="w-3 h-3 text-emerald-600 shrink-0" />
                                            <span>Approved</span>
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end space-x-2">
                                        @if (applicant.Status == "Pending review")
                                        {
                                            <button @onclick="() => OpenReviewModal(applicant)" class="bg-amber-50 border border-amber-200 text-amber-800 hover:bg-amber-100 font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors cursor-pointer flex items-center space-x-1">
                                                <Blazicon Svg="Lucide.FileText" class="w-3.5 h-3.5 text-amber-600" />
                                                <span>Review</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button @onclick="() => OpenReviewModal(applicant)" class="bg-white border border-slate-200 hover:bg-slate-50 text-slate-600 font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors cursor-pointer flex items-center space-x-1">
                                                <Blazicon Svg="Lucide.Eye" class="w-3.5 h-3.5 text-slate-500" />
                                                <span>View</span>
                                            </button>
                                        }
                                        <button @onclick="() => RemoveApplicant(applicant)" title="Remove applicant from database" class="bg-white border border-rose-200 text-rose-600 hover:bg-rose-50 hover:border-rose-300 font-semibold text-xs px-2.5 py-1.5 rounded-lg transition-colors cursor-pointer flex items-center space-x-1">
                                            <Blazicon Svg="Lucide.Trash2" class="w-3.5 h-3.5 text-rose-500" />
                                            <span>Remove</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Workflow Information Footer -->
    <div class="mt-6 p-4 rounded-xl border border-slate-200 bg-slate-50 text-xs text-slate-500 space-y-1">
        <p class="font-semibold text-slate-700 flex items-center space-x-1">
            <Blazicon Svg="Lucide.ShieldCheck" class="w-3.5 h-3.5 text-slate-400" />
            <span>Vetting &amp; Role Provisioning Architecture:</span>
        </p>
        <p>Approving an applicant verifies their regulatory accreditation (SAPC Pharmacy Licence, HPCSA Medical Registration, Professional Driving Permit) and automatically provisions their platform RBAC account role.</p>
    </div>
    }
</div>

<!-- Review & Vetting Modal -->
@if (showReviewModal && activeApplicant != null)
{
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 flex items-center justify-center p-4 animate-fade-in">
        <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[85vh] flex flex-col shadow-2xl">
            <!-- Modal Header (fixed) -->
            <div class="flex justify-between items-center pb-3 border-b border-slate-100 shrink-0">
                <div>
                    <h3 class="text-lg font-semibold text-slate-900">Review Application</h3>
                    <p class="text-xs text-slate-500 mt-0.5">@activeApplicant.Category Vetting Workflow</p>
                </div>
                <button @onclick="() => showReviewModal = false" class="text-slate-400 hover:text-slate-600 cursor-pointer p-1 rounded-lg hover:bg-slate-100 transition-colors">
                    <Blazicon Svg="Lucide.X" class="w-5 h-5" />
                </button>
            </div>

            <!-- Modal Content Body (scrollable) -->
            <div class="py-4 space-y-4 text-sm text-slate-600 overflow-y-auto grow pr-1">
                <div class="bg-slate-50 p-4 rounded-xl space-y-2.5 border border-slate-100">
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-semibold text-slate-400 uppercase">Applicant Name:</span>
                        <span class="font-semibold text-slate-900">@activeApplicant.Name</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-semibold text-slate-400 uppercase">Category:</span>
                        <span class="font-medium text-slate-700">@activeApplicant.Category</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-semibold text-slate-400 uppercase">Licence / Details:</span>
                        <span class="font-medium text-slate-700">@activeApplicant.SubText</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-semibold text-slate-400 uppercase">Location:</span>
                        <span class="font-medium text-slate-700">@activeApplicant.Location</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-semibold text-slate-400 uppercase">Submission Date:</span>
                        <span class="font-medium text-slate-700">@activeApplicant.SubmittedDate</span>
                    </div>
                </div>

                <div class="space-y-2">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Required Vetting Checks</p>
                    @if (activeApplicant.Category == "Pharmacies")
                    {
                        <div class="p-3 rounded-lg bg-emerald-50 border border-emerald-100 text-emerald-800 text-xs font-medium flex items-center space-x-2">
                            <Blazicon Svg="Lucide.Check" class="w-4 h-4 text-emerald-600 shrink-0" />
                            <span>SAPC Pharmacy Premises Licence &amp; Council Registration verified.</span>
                        </div>
                    }
                    else if (activeApplicant.Category == "Doctors")
                    {
                        <div class="p-3 rounded-lg bg-emerald-50 border border-emerald-100 text-emerald-800 text-xs font-medium flex items-center space-x-2">
                            <Blazicon Svg="Lucide.Check" class="w-4 h-4 text-emerald-600 shrink-0" />
                            <span>HPCSA Medical Practitioner Registration &amp; Practice Number verified.</span>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 rounded-lg bg-emerald-50 border border-emerald-100 text-emerald-800 text-xs font-medium flex items-center space-x-2">
                            <Blazicon Svg="Lucide.Check" class="w-4 h-4 text-emerald-600 shrink-0" />
                            <span>Fleet Registration &amp; Courier Driver PDP verified.</span>
                        </div>
                    }
                </div>

                <div>
                    <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-1">Vetting Notes / Checklists</label>
                    <textarea rows="2" placeholder="SAPC / HPCSA licence verified via official registry API..." class="w-full px-4 py-2 rounded-lg border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500"></textarea>
                </div>
            </div>

            <!-- Modal Footer (fixed) -->
            <div class="flex items-center justify-between pt-4 border-t border-slate-100 shrink-0">
                <button @onclick="() => RemoveApplicant(activeApplicant)" class="px-3.5 py-2 rounded-lg border border-rose-200 text-rose-600 font-medium text-xs hover:bg-rose-50 transition-colors cursor-pointer flex items-center space-x-1.5">
                    <Blazicon Svg="Lucide.Trash2" class="w-4 h-4" />
                    <span>Remove Applicant</span>
                </button>
                <div class="flex items-center space-x-2">
                    <button @onclick="() => showReviewModal = false" class="px-4 py-2 rounded-lg border border-slate-200 text-slate-700 font-medium text-sm hover:bg-slate-50 transition-colors cursor-pointer">
                        Close
                    </button>
                    @if (activeApplicant.Status == "Pending review")
                    {
                        <button @onclick="ApproveApplicant" class="px-5 py-2 rounded-lg bg-emerald-600 text-white font-medium text-sm hover:bg-emerald-700 transition-colors shadow-xs cursor-pointer flex items-center space-x-2">
                            <Blazicon Svg="Lucide.Check" class="w-4 h-4" />
                            <span>Approve &amp; Provision</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string selectedTab = "Pharmacies";
    private string? toastMessage;
    private bool showReviewModal = false;
    private bool isLoading = true;
    private OnboardingApplicantModel? activeApplicant;

    private List<OnboardingApplicantModel> pharmacyApplicants = new();
    private List<OnboardingApplicantModel> doctorApplicants = new();
    private List<OnboardingApplicantModel> driverApplicants = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadApplicantsAsync(showLoading: true);
    }

    private async Task LoadApplicantsAsync(bool showLoading = false)
    {
        if (showLoading)
        {
            isLoading = true;
        }

        try
        {
            var allApplicants = (await AdminService.GetOnboardingApplicantsAsync()).ToList();
            pharmacyApplicants = allApplicants.Where(a => a.Category == "Pharmacies").ToList();
            doctorApplicants = allApplicants.Where(a => a.Category == "Doctors").ToList();
            driverApplicants = allApplicants.Where(a => a.Category == "Drivers").ToList();
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SetTab(string category)
    {
        selectedTab = category;
    }

    private IEnumerable<OnboardingApplicantModel> CurrentTabApplicants
    {
        get
        {
            return selectedTab switch
            {
                "Doctors" => doctorApplicants,
                "Drivers" => driverApplicants,
                _ => pharmacyApplicants
            };
        }
    }

    private void OpenReviewModal(OnboardingApplicantModel applicant)
    {
        activeApplicant = applicant;
        showReviewModal = true;
    }

    private async Task ApproveApplicant()
    {
        if (activeApplicant == null) return;

        var name = activeApplicant.Name;
        var cat = activeApplicant.Category;
        var id = activeApplicant.Id;

        // Close modal immediately and show toast notification
        showReviewModal = false;
        toastMessage = $"Approved {name}! Account created & role provisioned in database.";
        activeApplicant.Status = "Approved";
        StateHasChanged();

        try
        {
            await AdminService.ApproveOnboardingApplicantAsync(id, name, cat);
            await LoadApplicantsAsync(showLoading: false);
        }
        catch
        {
            await LoadApplicantsAsync(showLoading: false);
        }

        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            toastMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task RemoveApplicant(OnboardingApplicantModel applicant)
    {
        if (applicant == null) return;

        var name = applicant.Name;
        var id = applicant.Id;

        // Close modal if open
        showReviewModal = false;

        // Remove locally from UI lists immediately
        pharmacyApplicants.RemoveAll(a => a.Id == id);
        doctorApplicants.RemoveAll(a => a.Id == id);
        driverApplicants.RemoveAll(a => a.Id == id);

        toastMessage = $"Applicant '{name}' removed from onboarding pipeline & database.";
        StateHasChanged();

        try
        {
            await AdminService.DeleteOnboardingApplicantAsync(id, name);
            await LoadApplicantsAsync(showLoading: false);
        }
        catch
        {
            await LoadApplicantsAsync(showLoading: false);
        }

        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            toastMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }
}
