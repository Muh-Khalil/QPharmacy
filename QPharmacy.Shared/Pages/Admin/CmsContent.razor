@page "/admin/cms"
@attribute [Authorize(Roles = "Admin")]
@using QPharmacy.Services
@using QPharmacy.Shared.Models.Database
@inject NavigationManager Navigation
@inject IAdminService AdminService

<div class="max-w-6xl mx-auto pb-12">
    <!-- Header Context -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-6 gap-4">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900 tracking-tight">CMS &amp; Content Management</h1>
            <p class="text-sm text-slate-500 mt-1">Manage health education articles, banners, and marketplace promotions.</p>
        </div>
        <div>
            <button @onclick="OpenCreateModal" class="bg-slate-900 hover:bg-slate-800 text-white font-medium text-sm px-4 py-2.5 rounded-lg shadow-sm transition-colors flex items-center space-x-2 cursor-pointer">
                <Blazicon Svg="Lucide.Plus" class="w-4 h-4" />
                <span>Create New Article</span>
            </button>
        </div>
    </div>

    <!-- Top-Right Floating Notification Toast Container -->
    <div class="fixed top-5 right-5 z-[100] max-w-sm sm:max-w-md w-full flex flex-col gap-3 pointer-events-none">
        @if (!string.IsNullOrEmpty(toastMessage))
        {
            <div class="pointer-events-auto p-4 rounded-xl flex items-center justify-between bg-emerald-50 text-emerald-900 border border-emerald-200 shadow-xl animate-fade-in transition-all">
                <div class="flex items-center space-x-3">
                    <Blazicon Svg="Lucide.Check" class="w-5 h-5 text-emerald-600 shrink-0" />
                    <span class="font-medium text-sm">@toastMessage</span>
                </div>
                <button @onclick="() => toastMessage = null" class="text-emerald-500 hover:text-emerald-700 transition-colors cursor-pointer shrink-0 ml-3">
                    <Blazicon Svg="Lucide.X" class="w-4 h-4" />
                </button>
            </div>
        }
    </div>

    @if (isLoading)
    {
        <div class="flex justify-center py-20">
            <svg class="animate-spin h-10 w-10 text-emerald-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
        </div>
    }
    else
    {
        <!-- Content Management Table Card -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <!-- Search Bar & Filters -->
        <div class="p-4 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/50">
            <div class="relative w-full sm:w-72">
                <Blazicon Svg="Lucide.Search" class="w-4 h-4 text-slate-400 absolute left-3 top-3" />
                <input type="text" value="@searchTerm" @oninput="OnSearchChanged" placeholder="Search CMS content..." class="w-full pl-9 pr-4 py-2 rounded-lg border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 bg-white" />
            </div>
            <div class="flex items-center space-x-2 text-xs font-semibold text-slate-500 overflow-x-auto">
                <span>Type:</span>
                <button @onclick='() => SelectCategory("All")' class="px-3 py-1.5 rounded-lg transition-colors cursor-pointer @(selectedCategory == "All" ? "bg-slate-900 text-white" : "bg-white border border-slate-200 text-slate-700 hover:bg-slate-100")">
                    All (@contentList.Count)
                </button>
                <button @onclick='() => SelectCategory("Health Guide")' class="px-3 py-1.5 rounded-lg transition-colors cursor-pointer @(selectedCategory == "Health Guide" ? "bg-slate-900 text-white" : "bg-white border border-slate-200 text-slate-700 hover:bg-slate-100")">
                    Health Guides
                </button>
                <button @onclick='() => SelectCategory("Promotional Banner")' class="px-3 py-1.5 rounded-lg transition-colors cursor-pointer @(selectedCategory == "Promotional Banner" ? "bg-slate-900 text-white" : "bg-white border border-slate-200 text-slate-700 hover:bg-slate-100")">
                    Banners
                </button>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-white text-xs font-semibold text-slate-400 uppercase tracking-wider border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4">TITLE</th>
                        <th class="px-6 py-4">CATEGORY</th>
                        <th class="px-6 py-4">PUBLISHED</th>
                        <th class="px-6 py-4">STATUS</th>
                        <th class="px-6 py-4 text-right">ACTION</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (contentList == null || !contentList.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-slate-400">
                                No CMS articles or banners found matching criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in contentList)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4 font-semibold text-slate-900">@item.Title</td>
                                <td class="px-6 py-4 text-slate-700 font-medium whitespace-nowrap">@item.Category</td>
                                <td class="px-6 py-4 text-slate-500 font-medium whitespace-nowrap">@item.PublishedDate</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (item.Status == "Published")
                                    {
                                        <span class="bg-emerald-50 text-emerald-800 border border-emerald-200/70 px-2.5 py-1 rounded-full text-xs font-semibold inline-flex items-center space-x-1.5">
                                            <Blazicon Svg="Lucide.Check" class="w-3 h-3 text-emerald-600 shrink-0" />
                                            <span>Published</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bg-amber-50 text-amber-800 border border-amber-200/70 px-2.5 py-1 rounded-full text-xs font-semibold inline-flex items-center space-x-1.5">
                                            <Blazicon Svg="Lucide.FileText" class="w-3 h-3 text-amber-600 shrink-0" />
                                            <span>Draft</span>
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <button @onclick="() => EditItem(item)" class="bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors shadow-2xs cursor-pointer flex items-center space-x-1 ml-auto">
                                        <Blazicon Svg="Lucide.FileText" class="w-3.5 h-3.5 text-slate-500" />
                                        <span>Edit</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    }
</div>

<!-- Create / Edit Content Modal -->
@if (showModal)
{
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 flex items-center justify-center p-4 animate-fade-in">
        <div class="bg-white rounded-2xl p-6 md:p-8 max-w-lg w-full shadow-2xl space-y-6">
            <div class="flex justify-between items-center pb-2 border-b border-slate-100">
                <h3 class="text-lg font-semibold text-slate-900">@(isEditing ? "Edit Article" : "Create New Content")</h3>
                <button @onclick="() => showModal = false" class="text-slate-400 hover:text-slate-600 cursor-pointer">
                    <Blazicon Svg="Lucide.X" class="w-5 h-5" />
                </button>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-1">Title</label>
                    <input type="text" @bind="newTitle" placeholder="e.g. Managing Diabetes in 2026" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500" />
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-1">Category</label>
                    <select @bind="newCategory" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 bg-white">
                        <option value="Health Guide">Health Guide</option>
                        <option value="Promotional Banner">Promotional Banner</option>
                        <option value="Platform Announcement">Platform Announcement</option>
                    </select>
                </div>
            </div>

            <div class="flex items-center justify-end space-x-3 pt-4 border-t border-slate-100">
                <button @onclick="() => showModal = false" class="px-4 py-2 rounded-lg border border-slate-200 text-slate-700 font-medium text-sm hover:bg-slate-50 transition-colors cursor-pointer">
                    Cancel
                </button>
                <button @onclick="SaveContent" class="px-5 py-2 rounded-lg bg-slate-900 text-white font-medium text-sm hover:bg-slate-800 transition-colors shadow-sm cursor-pointer">
                    Publish Content
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string? toastMessage;
    private string searchTerm = "";
    private string selectedCategory = "All";
    private bool showModal = false;
    private bool isEditing = false;
    private bool isLoading = true;
    private AdminCmsModel? activeItem;

    private string newTitle = "";
    private string newCategory = "Health Guide";

    private List<AdminCmsModel> contentList = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCmsContentAsync();
    }

    private async Task LoadCmsContentAsync()
    {
        isLoading = true;
        try
        {
            contentList = (await AdminService.GetCmsContentAsync(selectedCategory, searchTerm)).ToList();
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        await LoadCmsContentAsync();
    }

    private async Task SelectCategory(string category)
    {
        selectedCategory = category;
        await LoadCmsContentAsync();
    }

    private void OpenCreateModal()
    {
        isEditing = false;
        activeItem = null;
        newTitle = "";
        newCategory = "Health Guide";
        showModal = true;
    }

    private void EditItem(AdminCmsModel item)
    {
        activeItem = item;
        isEditing = true;
        newTitle = item.Title;
        newCategory = item.Category;
        showModal = true;
    }

    private async Task SaveContent()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;

        var modelToSave = activeItem ?? new AdminCmsModel
        {
            Id = Guid.NewGuid(),
            PublishedDate = DateTime.UtcNow.ToString("d MMM yyyy"),
            Status = "Published"
        };

        modelToSave.Title = newTitle;
        modelToSave.Category = newCategory;

        var success = await AdminService.SaveCmsContentAsync(modelToSave);
        if (success)
        {
            showModal = false;
            toastMessage = isEditing ? $"Updated content article '{newTitle}'. Saved to database!" : $"Created and published new article '{newTitle}'. Saved to database!";
            await LoadCmsContentAsync();
        }
    }
}
