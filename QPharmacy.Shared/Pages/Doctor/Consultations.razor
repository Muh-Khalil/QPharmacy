                <div class="w-7 h-7 rounded-full bg-teal-500 flex items-center justify-center text-white shadow-xs">
                    <Blazicon Svg="Lucide.MessageSquare" class="w-3.5 h-3.5" />
                </div>
                <div>
                    <h3 class="text-xs font-bold tracking-tight">Consultation Chat</h3>
                    <p class="text-xs text-emerald-400 font-medium flex items-center space-x-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                        <span>Live Sync</span>
                    </p>
                </div>
            </div>
            <button @onclick="ToggleChatModal" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition-colors cursor-pointer">
                <Blazicon Svg="Lucide.X" class="w-4 h-4" />
            </button>
        </div>

        <div id="chatContainer" @onclick="ClearUnreadBadge" class="flex-1 p-3.5 overflow-y-auto space-y-2.5 bg-slate-50/70">
            @if (session.ChatMessages == null || !session.ChatMessages.Any())
            {
                <div class="text-xs text-slate-400 italic text-center my-auto py-14">
                    No messages yet. Type below to start conversation...
                </div>
            }
            else
            {
                @foreach (var msg in session.ChatMessages)
                {
                    var isMe = (msg.SenderId.HasValue && currentDoctorId != Guid.Empty)
                        ? (msg.SenderId.Value == currentDoctorId)
                        : msg.IsDoctor;

                    <div class="flex flex-col @(isMe ? "items-end" : "items-start")">
                        <div class="max-w-[85%] rounded-2xl px-3.5 py-1.5 text-xs shadow-2xs @(isMe ? "bg-teal-600 text-white rounded-br-xs" : "bg-white text-slate-800 border border-slate-200/80 rounded-bl-xs")">
                            <span class="break-words leading-relaxed whitespace-pre-wrap">@msg.MessageText</span>
                            <span class="inline-block text-[10px] ml-2 select-none align-baseline whitespace-nowrap @(isMe ? "text-teal-100/80" : "text-slate-400")">
                                @FormatChatTime(msg.Timestamp)
                            </span>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="p-2.5 bg-white border-t border-slate-100">
            <div class="flex items-center space-x-1.5">
                <input type="text" @bind="newMessageText" @onkeyup="HandleKeyUp" @focus="ClearUnreadBadge"
