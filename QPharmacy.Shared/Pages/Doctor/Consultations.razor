    <div style="position: fixed; bottom: 24px; right: 24px; z-index: 99999; width: 340px; height: 480px;" class="bg-white rounded-2xl shadow-2xl flex flex-col border border-slate-300 overflow-hidden">
        <div class="px-4 py-3 bg-slate-900 text-white flex items-center justify-between shadow-xs select-none">
