@code {
    [SupplyParameterFromQuery]
    public string? PatientId { get; set; }

    [SupplyParameterFromQuery]
    public string? AppointmentId { get; set; }

    private enum ConsultationState { Queue, InCall }
    private ConsultationState consultationState = ConsultationState.Queue;

    private ConsultationSessionModel session = new();
    private List<WaitingLobbyPatientModel> waitingPatients = new();
    private List<DoctorScheduleItemModel> scheduleItems = new();
    private WaitingLobbyPatientModel? incomingPatientAlert;

    private string assessmentText = "";
    private string planText = "";
    private bool shouldIssueReferral = true;
    private string newMessageText = "";
    private string? notificationMessage;
    private bool isLoadingQueue = true;
    private string activeRightTab = "notes";

    private System.Threading.Timer? _chatRefreshTimer;
    private System.Threading.Timer? _callTimer;
    private System.Threading.Timer? _queuePollTimer;
    private TimeSpan _callDuration = TimeSpan.Zero;
    private int unreadBadgeCount = 0;
    private bool isMicMuted = false;
    private bool isCameraOff = false;
    private bool isRemoteCameraOff = false;
    private bool isRemoteMicMuted = false;
    private bool isAdminUser = false;
    private bool isDoctorUser = true;
    private bool isChatOpen = false;
    private string userDisplayName = "Doctor";
    private Guid currentDoctorId = Guid.NewGuid();

    // Wrap-Up Modal State
    private bool isWrapUpModalOpen = false;
    private string referralNoteText = "Specialist review recommended";
    private bool issuePrescriptionOnWrapUp = false;
    private string wrapUpMedication = "";
    private string wrapUpDosage = "";
    private string wrapUpPharmacy = "";

    // SignalR for lobby notifications
    private Microsoft.AspNetCore.SignalR.Client.HubConnection? _hubConnection;
    private DotNetObjectReference<Consultations>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        if (Guid.TryParse(AppointmentId, out var parsedApptId) && parsedApptId != Guid.Empty)
        {
            await LoadAndStartCallForAppointment(parsedApptId);
        }
        else if (Guid.TryParse(PatientId, out var parsedPatientId) && parsedPatientId != Guid.Empty)
        {
            await LoadAndStartCallForPatient(parsedPatientId);
        }
        else
        {
            consultationState = ConsultationState.Queue;
            await LoadQueueData();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var role = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "authRole");
            var name = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "authFirstName");
            var storedDoctorId = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "authUserId");

            if (Guid.TryParse(storedDoctorId, out var parsedDocId) && parsedDocId != Guid.Empty)
            {
                currentDoctorId = parsedDocId;
            }

            if (role == "Patient")
            {
                isDoctorUser = false;
                userDisplayName = !string.IsNullOrWhiteSpace(name) ? name : "Patient";
            }
            else if (role == "Admin" || role == "Super Admin")
            {
                isAdminUser = true;
                isDoctorUser = true;
                userDisplayName = "Super Admin";
            }
            else
            {
                isDoctorUser = true;
                userDisplayName = !string.IsNullOrWhiteSpace(name) ? name : "Doctor";
            }

            // Connect to lobby SignalR group
            await ConnectLobbySignalR();

            StateHasChanged();

            if (consultationState == ConsultationState.InCall)
            {
                isRemoteCameraOff = false;
                isRemoteMicMuted = false;
                var hubUrl = Navigation.ToAbsoluteUri("/consultationHub").ToString();
                var roomId = GetRoomId();
                session.RoomId = roomId;
                if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
                {
                    try
                    {
                        await _hubConnection.SendAsync("JoinRoom", roomId);
                        await _hubConnection.SendAsync("SendMediaStatus", roomId, isCameraOff, isMicMuted);
                    }
                    catch { }
                }
                await JSRuntime.InvokeVoidAsync("webrtcInterop.initialize", hubUrl, roomId, true, _dotNetRef);
            }
        }
        else if (consultationState == ConsultationState.InCall)
        {
            await JSRuntime.InvokeVoidAsync("webrtcInterop.rebindVideoElements");
        }
    }

    private async Task ConnectLobbySignalR()
    {
        try
        {
            var hubUrl = Navigation.ToAbsoluteUri("/consultationHub").ToString();
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            // Real-time notification when a patient enters lobby with 4 params (includes scheduled time)
            _hubConnection.On<string, string, string, string>("PatientIsWaiting", async (patientName, patientId, appointmentId, scheduledTime) =>
            {
                await HandlePatientWaitingAlert(patientName, patientId, appointmentId, scheduledTime);
            });

            // Backwards compatibility for 3-param notification
            _hubConnection.On<string, string, string>("PatientIsWaiting", async (patientName, patientId, appointmentId) =>
            {
                await HandlePatientWaitingAlert(patientName, patientId, appointmentId, "");
            });

            // Patient left lobby
            _hubConnection.On<string>("PatientLeftLobby", async (patientId) =>
            {
                if (Guid.TryParse(patientId, out var pid))
                {
                    waitingPatients.RemoveAll(p => p.PatientId == pid);
                    if (incomingPatientAlert?.PatientId == pid) incomingPatientAlert = null;
                }
                await InvokeAsync(StateHasChanged);
            });

            // Call Ended by patient
            _hubConnection.On("CallEnded", async () =>
            {
                await OnRemoteCallEnded();
            });

            _hubConnection.On<string>("ConsultationEndedInRoom", async (endedRoomId) =>
            {
                if (consultationState == ConsultationState.InCall &&
                    (string.Equals(endedRoomId, GetRoomId(), StringComparison.OrdinalIgnoreCase) ||
                     string.Equals(endedRoomId, session.RoomId, StringComparison.OrdinalIgnoreCase)))
                {
                    await OnRemoteCallEnded();
                }
            });

            _hubConnection.On<bool, bool>("ReceiveRemoteMediaStatus", (remoteCameraOff, remoteMicMuted) =>
            {
                isRemoteCameraOff = remoteCameraOff;
                isRemoteMicMuted = remoteMicMuted;
                InvokeAsync(StateHasChanged);
            });

            await _hubConnection.StartAsync();

            // Join the doctor's lobby group
            var doctorLobbyRoomId = $"lobby-doctor-{currentDoctorId.ToString().ToLowerInvariant()}";
            await _hubConnection.SendAsync("DoctorJoinLobby", doctorLobbyRoomId);
        }
        catch { }
    }

    [JSInvokable]
    public void OnRemoteMediaStatusChanged(bool remoteCameraOff, bool remoteMicMuted)
    {
        isRemoteCameraOff = remoteCameraOff;
        isRemoteMicMuted = remoteMicMuted;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnRemoteCallEnded()
    {
        await InvokeAsync(async () =>
        {
            if (consultationState == ConsultationState.InCall)
            {
                session.IsLive = false;
                _callTimer?.Dispose();
                _callTimer = null;
                try { await JSRuntime.InvokeVoidAsync("webrtcInterop.endCall", false); } catch { }
                notificationMessage = "Patient has left the consultation call. Please review notes and sign off.";
                if (string.IsNullOrWhiteSpace(assessmentText) && !string.IsNullOrWhiteSpace(session.Assessment))
                    assessmentText = session.Assessment;
                if (string.IsNullOrWhiteSpace(planText) && !string.IsNullOrWhiteSpace(session.Plan))
                    planText = session.Plan;
                isWrapUpModalOpen = true;
                StateHasChanged();
            }
        });
    }

    private async Task HandlePatientWaitingAlert(string patientName, string patientId, string appointmentId, string scheduledTime)
    {
        var alert = new WaitingLobbyPatientModel
        {
            PatientName = patientName,
            PatientId = Guid.TryParse(patientId, out var pid) ? pid : Guid.Empty,
            AppointmentId = Guid.TryParse(appointmentId, out var aid) ? aid : Guid.Empty,
            Initials = patientName.Length >= 2 ? $"{patientName[0]}{patientName.Split(' ').LastOrDefault()?[0]}" : (patientName.Length > 0 ? patientName[..1] : "PT"),
            ScheduledTime = scheduledTime ?? "",
            JoinedLobbyAt = DateTime.UtcNow
        };

        if (!waitingPatients.Any(p => p.AppointmentId == alert.AppointmentId || (p.PatientId == alert.PatientId && alert.PatientId != Guid.Empty)))
        {
            waitingPatients.Insert(0, alert);
        }

        incomingPatientAlert = alert;

        // Play hospital dual-tone chime ringtone
        try { await JSRuntime.InvokeVoidAsync("webrtcInterop.playRingtone"); } catch { }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadQueueData()
    {
        isLoadingQueue = true;
        try
        {
            var waiting = (await DoctorService.GetWaitingPatientsAsync(isAdminUser ? Guid.Empty : currentDoctorId)).ToList();
            
            // Retain any in-memory waiting patient who arrived recently via socket event
            foreach (var p in waitingPatients)
            {
                if (!waiting.Any(w => (p.AppointmentId != Guid.Empty && w.AppointmentId == p.AppointmentId) || (p.PatientId != Guid.Empty && w.PatientId == p.PatientId)))
                {
                    if ((DateTime.UtcNow - p.JoinedLobbyAt).TotalMinutes < 3)
                    {
                        waiting.Add(p);
                    }
                }
            }
            waitingPatients = waiting;

            var schedule = await DoctorService.GetTodaysScheduleAsync(currentDoctorId);
            scheduleItems = schedule.ToList();
        }
        catch { }
        finally
        {
            isLoadingQueue = false;
        }

        // Poll queue every 5s to refresh schedule time and sync DB
        _queuePollTimer?.Dispose();
        _queuePollTimer = new System.Threading.Timer(async _ =>
        {
            if (consultationState == ConsultationState.Queue)
            {
                await InvokeAsync(async () =>
                {
                    var waiting = (await DoctorService.GetWaitingPatientsAsync(isAdminUser ? Guid.Empty : currentDoctorId)).ToList();
                    foreach (var p in waitingPatients)
                    {
                        if (!waiting.Any(w => (p.AppointmentId != Guid.Empty && w.AppointmentId == p.AppointmentId) || (p.PatientId != Guid.Empty && w.PatientId == p.PatientId)))
                        {
                            if ((DateTime.UtcNow - p.JoinedLobbyAt).TotalMinutes < 3)
                            {
                                waiting.Add(p);
                            }
                        }
                    }
                    waitingPatients = waiting;

                    var schedule = await DoctorService.GetTodaysScheduleAsync(currentDoctorId);
                    scheduleItems = schedule.ToList();
                    StateHasChanged();
                });
            }
        }, null, 5000, 5000);
    }

    private bool IsAppointmentTimeReached(DoctorScheduleItemModel item)
    {
        if (item.AppointmentDate.HasValue)
        {
            return DateTime.Now >= item.AppointmentDate.Value;
        }
        if (!string.IsNullOrWhiteSpace(item.Time) && TimeSpan.TryParse(item.Time, out var timeSpan))
        {
            return DateTime.Now.TimeOfDay >= timeSpan;
        }
        return true;
    }

    private async Task CallSchedulePatient(DoctorScheduleItemModel item)
    {
        if (string.Equals(item.Status, "Completed", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var waitingModel = new WaitingLobbyPatientModel
        {
            AppointmentId = item.AppointmentId ?? Guid.Empty,
            PatientId = item.PatientId,
            PatientName = item.PatientName,
            Initials = item.Initials,
            ScheduledTime = item.Time
        };
        await AcceptPatient(waitingModel);
    }

    private async Task AcceptPatient(WaitingLobbyPatientModel patient)
    {
        try
        {
            incomingPatientAlert = null;

            // Update URL to preserve session across page refresh
            var apptId = patient.AppointmentId != Guid.Empty ? patient.AppointmentId : Guid.NewGuid();
            Navigation.NavigateTo($"/doctor/consultations?patientId={patient.PatientId}&appointmentId={apptId}", replace: true);

            // Accept in DB and get/create consultation session
            var acceptedSession = await DoctorService.AcceptPatientConsultationAsync(
                apptId, patient.PatientId, currentDoctorId);

            session = acceptedSession;
            session.RoomId = $"room-consultation-{apptId.ToString().ToLowerInvariant()}";
            session.PatientName = patient.PatientName;

            // Notify patient via SignalR and join consultation room
            if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
            {
                var patientRoomId = $"lobby-patient-{patient.PatientId.ToString().ToLowerInvariant()}";
                await _hubConnection.SendAsync("DoctorAcceptedPatient", patientRoomId, userDisplayName, apptId.ToString());
                try
                {
                    await _hubConnection.SendAsync("JoinRoom", session.RoomId);
                    await _hubConnection.SendAsync("SendMediaStatus", session.RoomId, isCameraOff, isMicMuted);
                }
                catch { }
            }

            isRemoteCameraOff = false;
            isRemoteMicMuted = false;
            consultationState = ConsultationState.InCall;
            waitingPatients.RemoveAll(p => p.AppointmentId == apptId || p.PatientId == patient.PatientId);

            SyncCallDuration();
            StartCallTimers();

            StateHasChanged();

            // Initialize WebRTC as caller
            var hubUrl = Navigation.ToAbsoluteUri("/consultationHub").ToString();
            await JSRuntime.InvokeVoidAsync("webrtcInterop.initialize", hubUrl, session.RoomId, true, _dotNetRef);
        }
        catch (Exception ex)
        {
            notificationMessage = $"Failed to start consultation: {ex.Message}";
            _ = ClearToastLater();
        }
    }

    private async Task LoadAndStartCallForAppointment(Guid appointmentId)
    {
        try
        {
            var existingSession = await DoctorService.GetConsultationSessionByAppointmentIdAsync(appointmentId);
            if (existingSession != null)
            {
                session = existingSession;
                session.RoomId = $"room-consultation-{appointmentId.ToString().ToLowerInvariant()}";
                consultationState = ConsultationState.InCall;

                SyncCallDuration();
                StartCallTimers();
            }
            else
            {
                consultationState = ConsultationState.Queue;
                await LoadQueueData();
            }
        }
        catch
        {
            consultationState = ConsultationState.Queue;
            await LoadQueueData();
        }
    }

    private async Task LoadAndStartCallForPatient(Guid patientId)
    {
        try
        {
            var existingSession = await DoctorService.GetConsultationSessionAsync(patientId);
            if (existingSession != null)
            {
                session = existingSession;
                session.RoomId = session.AppointmentId.HasValue && session.AppointmentId.Value != Guid.Empty
                    ? $"room-consultation-{session.AppointmentId.Value.ToString().ToLowerInvariant()}"
                    : $"room-{patientId.ToString().ToLowerInvariant()}";
                consultationState = ConsultationState.InCall;

                SyncCallDuration();
                StartCallTimers();
            }
            else
            {
                consultationState = ConsultationState.Queue;
                await LoadQueueData();
            }
        }
        catch
        {
            consultationState = ConsultationState.Queue;
            await LoadQueueData();
        }
    }

    private void SyncCallDuration()
    {
        var callStart = session.StartedAt ?? session.CreatedAt;
        if (callStart.HasValue && callStart.Value != default)
        {
            var elapsed = DateTime.UtcNow - callStart.Value;
            if (elapsed >= TimeSpan.Zero)
            {
                _callDuration = elapsed;
            }
        }
        else
        {
            _callDuration = TimeSpan.Zero;
        }
    }

    private void StartCallTimers()
    {
        _callTimer?.Dispose();
        _callTimer = new System.Threading.Timer(_ =>
        {
            _callDuration = _callDuration.Add(TimeSpan.FromSeconds(1));
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);

        _chatRefreshTimer?.Dispose();
        _chatRefreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshSessionData();
                StateHasChanged();
            });
        }, null, 1500, 1500);
    }

    private string GetRoomId()
    {
        if (session.AppointmentId.HasValue && session.AppointmentId.Value != Guid.Empty)
            return $"room-consultation-{session.AppointmentId.Value.ToString().ToLowerInvariant()}";
        if (Guid.TryParse(AppointmentId, out var apptGuid) && apptGuid != Guid.Empty)
            return $"room-consultation-{apptGuid.ToString().ToLowerInvariant()}";
        if (!string.IsNullOrWhiteSpace(session.RoomId)) return session.RoomId;
        var pid = session.PatientId != Guid.Empty ? session.PatientId : currentDoctorId;
        return $"room-{pid.ToString().ToLowerInvariant()}";
    }

    private async Task RefreshQueue() => await LoadQueueData();

    private async Task RefreshSessionData()
    {
        try
        {
            ConsultationSessionModel? updatedSession = null;
            if (session.AppointmentId.HasValue && session.AppointmentId.Value != Guid.Empty)
            {
                updatedSession = await DoctorService.GetConsultationSessionByAppointmentIdAsync(session.AppointmentId.Value);
            }
            if (updatedSession == null && session.PatientId != Guid.Empty)
            {
                updatedSession = await DoctorService.GetConsultationSessionAsync(session.PatientId);
            }

            if (updatedSession != null)
            {
                if ((!updatedSession.IsLive || updatedSession.Status == "Completed") && consultationState == ConsultationState.InCall)
                {
                    session.IsLive = false;
                    _callTimer?.Dispose();
                    _callTimer = null;
                    try { await JSRuntime.InvokeVoidAsync("webrtcInterop.endCall", false); } catch { }
                    if (!isWrapUpModalOpen)
                    {
                        notificationMessage = "Patient has left the consultation call. Please review notes and sign off.";
                        if (string.IsNullOrWhiteSpace(assessmentText) && !string.IsNullOrWhiteSpace(updatedSession.Assessment))
                            assessmentText = updatedSession.Assessment;
                        if (string.IsNullOrWhiteSpace(planText) && !string.IsNullOrWhiteSpace(updatedSession.Plan))
                            planText = updatedSession.Plan;
                        isWrapUpModalOpen = true;
                        StateHasChanged();
                    }
                    return;
                }

                session = updatedSession;
                SyncCallDuration();

                var messages = updatedSession.ChatMessages ?? new List<ConsultationChatMessageModel>();

                // Unread messages count based on DB IsRead flag
                if (isChatOpen)
                {
                    unreadBadgeCount = 0;
                    await DoctorService.MarkMessagesAsReadAsync(session.Id, isDoctorViewer: true);
                }
                else
                {
                    unreadBadgeCount = messages.Count(m => !m.IsDoctor && !m.IsRead);
                }

                if (string.IsNullOrEmpty(assessmentText) && !string.IsNullOrEmpty(session.Assessment))
                    assessmentText = session.Assessment;
                if (string.IsNullOrEmpty(planText) && !string.IsNullOrEmpty(session.Plan))
                    planText = session.Plan;
            }
        }
        catch { }
    }

    private async Task ToggleMic()
    {
        isMicMuted = !isMicMuted;
        await JSRuntime.InvokeVoidAsync("webrtcInterop.toggleMic", isMicMuted);
        await BroadcastMediaStatus();
    }

    private async Task ToggleCamera()
    {
        isCameraOff = !isCameraOff;
        await JSRuntime.InvokeVoidAsync("webrtcInterop.toggleCamera", isCameraOff);
        await BroadcastMediaStatus();
    }

    private async Task BroadcastMediaStatus()
    {
        try
        {
            var roomId = GetRoomId();
            if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected && !string.IsNullOrWhiteSpace(roomId))
            {
                await _hubConnection.SendAsync("SendMediaStatus", roomId, isCameraOff, isMicMuted);
            }
        }
        catch { }
    }

    private async Task ClearToastLater()
    {
        await Task.Delay(2500);
        notificationMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleChatModal()
    {
        isChatOpen = !isChatOpen;
        if (isChatOpen)
        {
            unreadBadgeCount = 0;
            await DoctorService.MarkMessagesAsReadAsync(session.Id, isDoctorViewer: true);
            _ = Task.Run(async () =>
            {
                await Task.Delay(100);
                await ScrollChatToBottom();
            });
        }
    }

    private async Task ClearUnreadBadge()
    {
        unreadBadgeCount = 0;
        await DoctorService.MarkMessagesAsReadAsync(session.Id, isDoctorViewer: true);
    }

    private async Task SaveClinicalNote()
    {
        if (string.IsNullOrWhiteSpace(assessmentText) && string.IsNullOrWhiteSpace(planText))
        {
            notificationMessage = "Please enter assessment or plan notes before saving.";
            StateHasChanged();
            return;
        }
        await DoctorService.SaveClinicalNoteAndReferralAsync(session.Id, assessmentText, planText, shouldIssueReferral);
        notificationMessage = "Clinical note saved successfully!";
        StateHasChanged();
        _ = ClearToastLater();
    }

    private async Task SendChatMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessageText)) return;
        var text = newMessageText.Trim();
        newMessageText = "";

        try
        {
            await DoctorService.SendChatMessageAsync(session.Id, userDisplayName, text, isDoctorUser, currentDoctorId);
            try { await JSRuntime.InvokeVoidAsync("webrtcInterop.sendChatMessage", GetRoomId(), userDisplayName, text, isDoctorUser, currentDoctorId.ToString()); } catch { }
            unreadBadgeCount = 0;
            await RefreshSessionData();
            StateHasChanged();
            await ScrollChatToBottom();
        }
        catch (Exception ex)
        {
            notificationMessage = $"Failed to send message: {ex.Message}";
            _ = ClearToastLater();
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendChatMessage();
    }

    private async Task ScrollChatToBottom()
    {
        try { await JSRuntime.InvokeVoidAsync("eval", "var el = document.getElementById('chatContainer'); if(el) el.scrollTop = el.scrollHeight;"); } catch { }
    }

    private string FormatChatTime(DateTime timestamp)
    {
        if (timestamp == default) return "Just now";
        DateTime localTime = timestamp.Kind switch
        {
            DateTimeKind.Utc => timestamp.ToLocalTime(),
            DateTimeKind.Unspecified => DateTime.SpecifyKind(timestamp, DateTimeKind.Utc).ToLocalTime(),
            _ => timestamp
        };
        return localTime.ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture);
    }

    private async Task OpenWrapUpModal()
    {
        session.IsLive = false;
        _callTimer?.Dispose();
        _callTimer = null;
        try
        {
            await JSRuntime.InvokeVoidAsync("webrtcInterop.notifyCallEnded", GetRoomId());
            await JSRuntime.InvokeVoidAsync("webrtcInterop.endCall", false);
        }
        catch { }

        if (string.IsNullOrWhiteSpace(assessmentText) && !string.IsNullOrWhiteSpace(session.Assessment))
            assessmentText = session.Assessment;
        if (string.IsNullOrWhiteSpace(planText) && !string.IsNullOrWhiteSpace(session.Plan))
            planText = session.Plan;
        isWrapUpModalOpen = true;
        StateHasChanged();
    }

    private void CloseWrapUpModal() => isWrapUpModalOpen = false;

    private async Task SubmitWrapUp()
    {
        DoctorPrescriptionModel? script = null;
        if (issuePrescriptionOnWrapUp && !string.IsNullOrWhiteSpace(wrapUpMedication))
        {
            script = new DoctorPrescriptionModel
            {
                Id = Guid.NewGuid(),
                PatientId = session.PatientId,
                PatientName = session.PatientName,
                Medication = wrapUpMedication,
                DosageDuration = wrapUpDosage,
                PreferredPharmacy = wrapUpPharmacy,
                Status = "Awaiting verification",
                CreatedAt = DateTime.UtcNow
            };
        }

        var refNote = shouldIssueReferral ? referralNoteText : null;
        await DoctorService.CompleteConsultationAsync(session.Id, assessmentText, planText, refNote, script);

        session.IsLive = false;
        isWrapUpModalOpen = false;

        try
        {
            await JSRuntime.InvokeVoidAsync("webrtcInterop.notifyCallEnded", GetRoomId());
            await JSRuntime.InvokeVoidAsync("webrtcInterop.endCall", false);
        }
        catch { }

        notificationMessage = "Consultation signed off and completed!" + (script != null ? " Prescription issued." : "");
        StateHasChanged();
        _ = ClearToastLater();

        // Return to queue after a delay
        await Task.Delay(1800);
        GoToQueue();
    }

    private async Task EndConsultation()
    {
        await OpenWrapUpModal();
    }

    private async Task AutoGenerateNotes()
    {
        notificationMessage = "AI generating notes from consultation audio...";
        StateHasChanged();
        await Task.Delay(2000);
        assessmentText = "Patient reports mild fatigue. Vitals appear normal over video. No acute distress observed.";
        planText = "Continue current medication routine. Monitor for changes and follow up in 2 weeks.";
        notificationMessage = "AI successfully generated clinical notes.";
        StateHasChanged();
        _ = ClearToastLater();
    }

    private void GoToQueue()
    {
        Navigation.NavigateTo("/doctor/consultations", replace: true);
        consultationState = ConsultationState.Queue;
        session = new ConsultationSessionModel();
        _callTimer?.Dispose();
        _callTimer = null;
        _chatRefreshTimer?.Dispose();
        _chatRefreshTimer = null;
        _callDuration = TimeSpan.Zero;
        unreadBadgeCount = 0;
        _ = LoadQueueData();
    }

    private async Task IssuePrescriptionForPatient()
    {
        if (!string.IsNullOrWhiteSpace(assessmentText) || !string.IsNullOrWhiteSpace(planText))
        {
            await DoctorService.SaveClinicalNoteAndReferralAsync(session.Id, assessmentText, planText, shouldIssueReferral);
        }
        Navigation.NavigateTo($"/doctor/prescriptions?patientName={Uri.EscapeDataString(session.PatientName)}");
    }

    private void DismissNotification() => notificationMessage = null;

    public void Dispose()
    {
        _chatRefreshTimer?.Dispose();
        _callTimer?.Dispose();
        _queuePollTimer?.Dispose();
        _dotNetRef?.Dispose();
        _ = Task.Run(async () =>
        {
            try { await JSRuntime.InvokeVoidAsync("webrtcInterop.endCall", false); } catch { }
            try { if (_hubConnection is not null) await _hubConnection.DisposeAsync(); }
            catch { }
        });
    }
}