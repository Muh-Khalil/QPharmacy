@page "/doctor/consultations"
@attribute [Authorize(Roles = "Doctor")]
@layout QPharmacy.Shared.Layout.MainLayout
@using QPharmacy.Services
@using QPharmacy.Shared.Models.Database
@using Blazicons
@using Microsoft.AspNetCore.SignalR.Client
@implements IDisposable
@inject IDoctorService DoctorService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Consultations - QPharmacy</PageTitle>

<div class="max-w-6xl mx-auto pb-12">
    <!-- Toast Notification -->
    @if (!string.IsNullOrEmpty(notificationMessage))
    {
        <div class="fixed top-6 right-6 z-50 bg-emerald-600 text-white px-4 py-3 rounded-lg shadow-lg flex items-center justify-between space-x-4 animate-in fade-in slide-in-from-top-4 duration-300">
            <div class="flex items-center space-x-2">
                <Blazicon Svg="Lucide.Check" class="w-5 h-5 text-white" />
                <span class="text-sm font-medium">@notificationMessage</span>
            </div>
            <button @onclick="DismissNotification" class="text-white hover:text-emerald-100 transition-colors">
                <Blazicon Svg="Lucide.X" class="w-4 h-4" />
            </button>
        </div>
    }

    <!-- Incoming patient alert (SignalR real-time) -->
    @if (incomingPatientAlert != null)
    {
        <div class="fixed top-6 right-6 z-50 bg-white border border-amber-300 shadow-2xl rounded-2xl p-5 max-w-sm w-full animate-in fade-in slide-in-from-top-4 duration-300">
            <div class="flex items-start space-x-3">
                <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center shrink-0">
                    <span class="relative flex h-4 w-4">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-4 w-4 bg-amber-500"></span>
                    </span>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-bold text-slate-900">Patient in Lobby</p>
                    <p class="text-xs text-slate-600 mt-0.5">
                        <span class="font-semibold">@incomingPatientAlert.PatientName</span> is waiting for their appointment.
                    </p>
                </div>
            </div>
            <div class="mt-3 flex items-center space-x-2">
                <button @onclick="() => AcceptPatient(incomingPatientAlert)"
                class="flex-1 bg-teal-600 hover:bg-teal-700 text-white font-semibold text-xs py-2 rounded-lg transition-colors cursor-pointer flex items-center justify-center space-x-1.5">
                <Blazicon Svg="Lucide.PhoneCall" class="w-3.5 h-3.5" />
                <span>Accept &amp; Start Call</span>
            </button>
            <button @onclick="() => incomingPatientAlert = null" class="px-3 py-2 border border-slate-200 text-slate-500 text-xs rounded-lg hover:bg-slate-50 transition-colors cursor-pointer">
            Later
        </button>
    </div>
</div>
}

<!-- ═══════════════════════════════════════════════════════════════
STATE 1: WAITING QUEUE — Doctor sees who is waiting
═══════════════════════════════════════════════════════════════ -->
@if (consultationState == ConsultationState.Queue)
{
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900 tracking-tight">Consultation Queue</h1>
            <p class="text-sm text-slate-500 mt-1">Patients waiting in lobby &bull; Accept a patient to begin their telehealth session.</p>
        </div>
        <button @onclick="RefreshQueue" class="border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-medium px-3.5 py-2 rounded-lg text-sm flex items-center space-x-2 transition-colors cursor-pointer shadow-sm">
            <Blazicon Svg="Lucide.RefreshCw" class="w-4 h-4" />
            <span>Refresh</span>
        </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Waiting Patients Queue Card -->
        <div class="lg:col-span-7 bg-white border border-slate-200 shadow-sm rounded-xl overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <h2 class="text-base font-semibold text-slate-900">Waiting in Lobby</h2>
                    @if (waitingPatients.Any())
                    {
                        <span class="bg-rose-100 text-rose-700 text-xs font-bold px-2 py-0.5 rounded-full flex items-center space-x-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
                            <span>@waitingPatients.Count waiting</span>
                        </span>
                    }
                </div>
            </div>

            @if (isLoadingQueue)
            {
                <div class="p-8 flex flex-col items-center justify-center space-y-2 text-slate-400">
                    <div class="w-8 h-8 border-2 border-teal-500 border-t-transparent rounded-full animate-spin"></div>
                    <p class="text-xs">Loading queue...</p>
                </div>
            }
            else if (!waitingPatients.Any())
            {
                <div class="p-12 flex flex-col items-center justify-center text-center space-y-3">
                    <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center">
                        <Blazicon Svg="Lucide.Users" class="w-8 h-8 text-slate-300" />
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-slate-600">No patients waiting</p>
                        <p class="text-xs text-slate-400 mt-0.5">When a patient joins the lobby for their appointment, they'll appear here.</p>
                    </div>
                    <div class="bg-blue-50 border border-blue-200 rounded-xl p-3 max-w-xs text-xs text-blue-700 text-left mt-2">
                        <span class="font-semibold">Tip:</span> Patients join the lobby from their Appointments page by clicking "Join Video Consultation".
                    </div>
                </div>
            }
            else
            {
                <div class="divide-y divide-slate-100">
                    @foreach (var patient in waitingPatients)
                    {
                        <div class="p-5 flex items-center justify-between hover:bg-slate-50/50 transition-colors">
                            <div class="flex items-center space-x-4 min-w-0">
                                <!-- Avatar with animated ring -->
                                <div class="relative shrink-0">
                                    <div class="w-12 h-12 rounded-full @patient.AvatarBgColor flex items-center justify-center text-white font-bold text-base shadow-sm">
                                        @patient.Initials
                                    </div>
                                    <!-- Pulse indicator: actively waiting -->
                                    <span class="absolute -bottom-0.5 -right-0.5 flex h-3.5 w-3.5">
                                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-amber-500 border-2 border-white"></span>
                                    </span>
                                </div>
                                <div class="min-w-0">
                                    <p class="font-semibold text-slate-900 text-sm truncate">@patient.PatientName</p>
                                    <p class="text-xs text-slate-500 mt-0.5 truncate">
                                        @(string.IsNullOrWhiteSpace(patient.AppointmentType) ? "Video Consultation" : patient.AppointmentType)
                                        &bull; Waiting @patient.WaitingMinutes min
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-2 shrink-0">
                                <button @onclick="() => AcceptPatient(patient)"
                                class="bg-teal-600 hover:bg-teal-700 text-white font-semibold text-xs px-4 py-2 rounded-lg shadow-sm transition-all hover:scale-105 flex items-center space-x-1.5 cursor-pointer">
                                <Blazicon Svg="Lucide.PhoneCall" class="w-3.5 h-3.5" />
                                <span>Accept</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Today's Schedule (Right column) -->
    <div class="lg:col-span-5 bg-white border border-slate-200 shadow-sm rounded-2xl p-5 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div class="flex items-center space-x-2">
                <div class="w-8 h-8 rounded-xl bg-teal-50 border border-teal-200/60 flex items-center justify-center text-teal-700">
                    <Blazicon Svg="Lucide.CalendarCheck2" class="w-4 h-4" />
                </div>
                <div>
                    <h2 class="text-sm font-bold text-slate-900">Today's Schedule</h2>
                    <p class="text-xs text-slate-400">Scheduled clinical appointments</p>
                </div>
            </div>
            <span class="text-xs font-semibold text-teal-800 bg-teal-50 border border-teal-200/60 px-2.5 py-0.5 rounded-full">
                @scheduleItems.Count
            </span>
        </div>

        @if (!scheduleItems.Any(i => !string.Equals(i.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)))
        {
            <div class="py-10 text-center text-slate-400 space-y-2">
                <Blazicon Svg="Lucide.Calendar" class="w-8 h-8 text-slate-300 mx-auto" />
                <p class="text-xs font-medium">No appointments scheduled for today.</p>
            </div>
        }
        else
        {
            <div class="space-y-2.5 max-h-[365px] overflow-y-auto pr-1.5 custom-scrollbar">
                @foreach (var item in scheduleItems.Where(i => !string.Equals(i.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)))
                {
                    var isCompleted = string.Equals(item.Status, "Completed", StringComparison.OrdinalIgnoreCase);
                    var isWaitingInLobby = string.Equals(item.Status, "WaitingInLobby", StringComparison.OrdinalIgnoreCase);
                    var isInCall = string.Equals(item.Status, "InProgress", StringComparison.OrdinalIgnoreCase);
                    var isTimeReached = IsAppointmentTimeReached(item);

                    <div class="p-3 h-[64px] rounded-xl border border-slate-100 bg-slate-50/50 hover:bg-slate-50 hover:border-slate-200 transition-all flex items-center justify-between space-x-3">
                        <div class="flex items-center space-x-3 min-w-0 flex-1">
                            <div class="w-9 h-9 rounded-xl @item.AvatarBgColor flex items-center justify-center text-white font-bold text-xs shadow-2xs shrink-0">
                                @item.Initials
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-bold text-slate-900 truncate">@item.PatientName</p>
                                <div class="flex items-center space-x-1.5 text-xs text-slate-500 mt-0.5 min-w-0">
                                    <span class="font-mono font-medium text-teal-700 bg-teal-50/80 px-1.5 py-0.5 rounded border border-teal-200/50 shrink-0 text-xs">@item.Time</span>
                                    <span class="truncate text-xs text-slate-500">&bull; @(string.IsNullOrWhiteSpace(item.AppointmentType) ? "Consult" : item.AppointmentType)</span>
                                </div>
                            </div>
                        </div>
                        <div class="shrink-0 flex items-center pl-1">
                            @if (isCompleted)
                            {
                                <span class="inline-flex items-center space-x-1 text-xs font-semibold text-blue-700 bg-blue-50 border border-blue-200/60 px-2.5 py-1 rounded-full whitespace-nowrap shadow-2xs">
                                    <Blazicon Svg="Lucide.Check" class="w-3.5 h-3.5 text-blue-600" />
                                    <span>Completed</span>
                                </span>
                            }
                            else if (isWaitingInLobby)
                            {
                                <button @onclick="() => CallSchedulePatient(item)" class="bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs px-2.5 py-1.5 rounded-lg flex items-center space-x-1 animate-pulse cursor-pointer shadow-sm whitespace-nowrap transition-colors">
                                    <Blazicon Svg="Lucide.PhoneCall" class="w-3.5 h-3.5" />
                                    <span>In Lobby</span>
                                </button>
                            }
                            else if (isInCall)
                            {
                                <button @onclick="() => CallSchedulePatient(item)" class="bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs px-2.5 py-1.5 rounded-lg flex items-center space-x-1 cursor-pointer shadow-sm whitespace-nowrap transition-colors">
                                    <Blazicon Svg="Lucide.Video" class="w-3.5 h-3.5" />
                                    <span>In Call</span>
                                </button>
                            }
                            else
                            {
                                @* Upcoming appointment *@
                                <div class="flex items-center space-x-1.5">
                                    <span class="inline-flex items-center space-x-1 text-xs font-medium text-slate-500 bg-slate-100 border border-slate-200/60 px-2 py-0.5 rounded-full whitespace-nowrap">
                                        <span>Upcoming</span>
                                    </span>
                                    @if (isTimeReached)
                                    {
                                        <button @onclick="() => CallSchedulePatient(item)" class="border border-slate-200 hover:border-teal-500 bg-white hover:bg-teal-50 text-slate-700 hover:text-teal-700 font-semibold text-xs px-3 py-1.5 rounded-lg flex items-center space-x-1.5 transition-all shadow-2xs cursor-pointer whitespace-nowrap">
                                            <Blazicon Svg="Lucide.Phone" class="w-3.5 h-3.5 text-teal-600" />
                                            <span>Call</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button disabled title="Call will be enabled at scheduled time (@item.Time)" class="border border-slate-200 bg-slate-100 text-slate-400 font-semibold text-xs px-2.5 py-1.5 rounded-lg flex items-center space-x-1.5 cursor-not-allowed opacity-60 whitespace-nowrap">
                                            <Blazicon Svg="Lucide.Clock" class="w-3.5 h-3.5 text-slate-400" />
                                            <span>Call</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
</div>
</div>
}

@if (consultationState == ConsultationState.InCall)
{
    <!-- Admin notice -->
    @if (isAdminUser)
    {
        <div class="mb-6 bg-amber-50 border border-amber-200 rounded-xl p-4 flex items-start gap-3 shadow-xs">
            <Blazicon Svg="Lucide.ShieldAlert" class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" />
            <div>
                <h4 class="text-sm font-bold text-amber-900">Super Admin Privacy Guard Active</h4>
                <p class="text-xs text-amber-800 leading-relaxed mt-0.5">
                    Active clinical consultations are restricted to licensed doctors and patients for medical privacy compliance.
                </p>
            </div>
        </div>
    }

    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900 tracking-tight">Clinical Consultation</h1>
            <p class="text-sm text-slate-500 mt-1">Live Telehealth Session with <span class="font-bold text-slate-800">@session.PatientName</span>.</p>
        </div>
        <div class="flex items-center space-x-3">
            @if (session.IsLive)
            {
                <span class="inline-flex items-center space-x-1.5 bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full text-xs font-semibold">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Live Session</span>
                </span>
                <button @onclick="OpenWrapUpModal" class="bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs px-3.5 py-1.5 rounded-lg shadow-sm transition-colors flex items-center space-x-1.5 cursor-pointer">
                    <Blazicon Svg="Lucide.PhoneOff" class="w-3.5 h-3.5" />
                    <span>End call &amp; Sign off</span>
                </button>
            }
            else
            {
                <span class="inline-flex items-center space-x-1 bg-slate-100 text-slate-600 px-3 py-1 rounded-full text-xs font-medium">
                    <span>Session Ended</span>
                </span>
                <button @onclick="GoToQueue" class="bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs px-3.5 py-1.5 rounded-lg shadow-sm transition-colors cursor-pointer">
                    <span>Back to Queue</span>
                </button>
            }
        </div>
    </div>

    <!-- 2-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
        <!-- Left: Video (2 cols) -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Main Video Room -->
            <div style="min-height: 480px; height: 480px;" class="bg-slate-950 border border-slate-800 shadow-2xl rounded-2xl relative overflow-hidden flex items-center justify-center w-full select-none">
                <!-- Call Timer Badge -->
                <div class="absolute top-4 left-4 bg-slate-900/90 backdrop-blur border border-slate-700/60 text-slate-200 text-xs font-mono px-3.5 py-1 rounded-full shadow-md flex items-center space-x-2 z-20">
                    <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
                    <span>@_callDuration.ToString(@"mm\:ss")</span>
                    <span class="text-slate-500 font-sans text-xs">REC</span>
                </div>

                <!-- Remote Video: Patient -->
                <div class="w-full h-full relative flex items-center justify-center bg-slate-950">
                    <video id="remoteVideo" class="w-full h-full object-cover" autoplay playsinline></video>

                    <!-- Remote Placeholder -->
                    <div id="remotePlaceholder" class="absolute inset-0 flex flex-col items-center justify-center text-slate-400 space-y-3 pointer-events-none @(isRemoteCameraOff ? "hidden" : "")">
                        <div class="w-16 h-16 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-teal-400">
                            <Blazicon Svg="Lucide.User" class="w-8 h-8" />
                        </div>
                        <div class="text-center">
                            <p class="text-sm font-semibold text-slate-200">@(string.IsNullOrWhiteSpace(session.PatientName) ? "Patient" : session.PatientName)</p>
                            <p class="text-xs text-slate-400">Connecting patient video stream...</p>
                        </div>
                    </div>

                    <!-- Remote Camera Off Banner Overlay -->
                    @if (isRemoteCameraOff)
                    {
                        <div class="absolute inset-0 bg-slate-950/95 flex flex-col items-center justify-center text-slate-400 space-y-3 z-15 backdrop-blur-xs">
                            <div class="w-16 h-16 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-amber-400 shadow-xl">
                                <Blazicon Svg="Lucide.VideoOff" class="w-8 h-8" />
                            </div>
                            <div class="text-center">
                                <p class="text-sm font-semibold text-slate-200">@(string.IsNullOrWhiteSpace(session.PatientName) ? "Patient" : session.PatientName)'s Camera is Off</p>
                                <p class="text-xs text-slate-400">Audio call remains active</p>
                            </div>
                        </div>
                    }

                    <!-- Patient Name Label with Muted Indicator -->
                    <div class="absolute bottom-16 left-5 bg-slate-900/80 backdrop-blur border border-slate-800 text-white text-xs px-3 py-1.5 rounded-xl shadow-lg flex items-center space-x-2 z-20">
                        <span class="w-2 h-2 rounded-full @(isRemoteCameraOff ? "bg-amber-400" : "bg-emerald-400")"></span>
                        <span class="font-medium">@(isDoctorUser ? session.PatientName : "Dr. " + session.DoctorName)</span>
                        @if (isRemoteMicMuted)
                        {
                            <span class="inline-flex items-center space-x-1 bg-rose-500/20 text-rose-300 border border-rose-500/40 px-1.5 py-0.5 rounded-md text-[10px] font-semibold">
                                <Blazicon Svg="Lucide.MicOff" class="w-2.5 h-2.5" />
                                <span>Muted</span>
                            </span>
                        }
                    </div>
                </div>

                <!-- Self-View PIP -->
                <div class="absolute top-5 right-5 w-40 h-40 sm:w-42 sm:h-42 bg-slate-900 border-2 border-slate-700/80 rounded-2xl overflow-hidden shadow-2xl flex items-center justify-center z-20">
                    <video id="localVideo" class="w-full h-full object-cover @(isCameraOff ? "hidden" : "")" autoplay playsinline muted></video>
                    @if (isCameraOff)
                    {
                        <div class="w-full h-full bg-slate-950 flex flex-col items-center justify-center text-slate-600">
                            <Blazicon Svg="Lucide.VideoOff" class="w-6 h-6 mb-1" />
                            <span class="text-xs font-medium">Camera Off</span>
                        </div>
                    }
                    @if (isMicMuted)
                    {
                        <div class="absolute top-2 right-2 bg-rose-600 text-white p-1 rounded-full shadow-xs z-30">
                            <Blazicon Svg="Lucide.MicOff" class="w-3 h-3" />
                        </div>
                    }
                    <div class="absolute bottom-1.5 left-2 bg-slate-900 text-slate-200 text-xs px-2 py-0.5 rounded-md font-medium border border-slate-600 shadow-xs z-30">
                        You
                    </div>
                </div>

                <!-- Bottom Controls -->
                <div class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-slate-900/90 backdrop-blur-md border border-slate-700/80 rounded-full px-6 py-2.5 flex items-center space-x-3.5 shadow-2xl z-30">
                    <button @onclick="ToggleMic" class="p-3 rounded-full transition-all cursor-pointer @(isMicMuted ? "bg-rose-600 text-white shadow-lg ring-2 ring-rose-500/40" : "bg-slate-800 text-slate-200 hover:bg-slate-700")" title="@(isMicMuted ? "Unmute Mic" : "Mute Mic")">
                        <Blazicon Svg="@(isMicMuted ? Lucide.MicOff : Lucide.Mic)" class="w-4.5 h-4.5" />
                    </button>
                    <button @onclick="ToggleCamera" class="p-3 rounded-full transition-all cursor-pointer @(isCameraOff ? "bg-rose-600 text-white shadow-lg ring-2 ring-rose-500/40" : "bg-slate-800 text-slate-200 hover:bg-slate-700")" title="@(isCameraOff ? "Turn Camera On" : "Turn Camera Off")">
                        <Blazicon Svg="@(isCameraOff ? Lucide.VideoOff : Lucide.Video)" class="w-4.5 h-4.5" />
                    </button>
                    <button @onclick="ToggleChatModal" class="relative p-3 rounded-full transition-all cursor-pointer @(isChatOpen ? "bg-teal-600 text-white shadow-lg ring-2 ring-teal-400/40" : "bg-slate-800 text-slate-200 hover:bg-slate-700")" title="Chat">
                        <Blazicon Svg="Lucide.MessageSquare" class="w-4.5 h-4.5" />
                        @if (unreadBadgeCount > 0)
                        {
                            <span class="absolute -top-2 -right-2 bg-rose-500 text-white text-xs font-extrabold w-5 h-5 rounded-full flex items-center justify-center shadow-lg animate-bounce border-2 border-slate-900 z-30">
                                @unreadBadgeCount
                            </span>
                        }
                    </button>
                    <button @onclick="EndConsultation" class="bg-rose-600 hover:bg-rose-700 text-white p-3 rounded-full shadow-lg transition-all hover:scale-105 cursor-pointer ml-1" title="End Call">
                        <Blazicon Svg="Lucide.PhoneOff" class="w-4.5 h-4.5" />
                    </button>
                </div>
            </div>
        </div>

        <!-- Right: Clinical Panel (Notes, Patient Chart, Chat) -->
        <div class="bg-white border border-slate-200 shadow-sm rounded-2xl overflow-hidden flex flex-col" style="min-height: 480px;">
            <!-- Panel Header with Tabs -->
            <div class="border-b border-slate-100 bg-slate-50/75 p-2 flex items-center justify-between">
                <div class="flex items-center space-x-1 bg-slate-200/70 p-1 rounded-xl w-full">
                    <button type="button" @onclick="@(() => activeRightTab = "notes")"
                    class="flex-1 py-1.5 text-xs font-bold rounded-lg transition-all flex items-center justify-center space-x-1.5 cursor-pointer @(activeRightTab == "notes" ? "bg-white text-slate-900 shadow-xs" : "text-slate-600 hover:text-slate-900")">
                    <Blazicon Svg="Lucide.ClipboardList" class="w-3.5 h-3.5" />
                    <span>Notes</span>
                </button>
                <button type="button" @onclick="@(() => activeRightTab = "chart")"
                class="flex-1 py-1.5 text-xs font-bold rounded-lg transition-all flex items-center justify-center space-x-1.5 cursor-pointer @(activeRightTab == "chart" ? "bg-white text-slate-900 shadow-xs" : "text-slate-600 hover:text-slate-900")">
                <Blazicon Svg="Lucide.UserCheck" class="w-3.5 h-3.5" />
                <span>Patient</span>
            </button>
        </div>
    </div>

    <!-- Tab 1: Clinical Notes -->
    @if (activeRightTab == "notes")
    {
