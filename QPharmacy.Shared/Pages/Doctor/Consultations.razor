                <button @onclick="SendChatMessage" class="bg-teal-600 hover:bg-teal-700 text-white p-2 rounded-xl text-xs font-semibold transition-colors flex items-center justify-center shadow-xs cursor-pointer">
                    <Blazicon Svg="Lucide.Send" class="w-3.5 h-3.5" />
                </button>
            </div>
        </div>
    </div>
}

