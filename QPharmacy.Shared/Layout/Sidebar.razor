@code {
    private string currentUri = "";
    private string currentRole = "Patient";

    protected override async Task OnInitializedAsync()
    {
        currentUri = Navigation.Uri;
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentRole = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Patient";
        Navigation.LocationChanged += OnLocationChanged;
        SidebarService.OnStateChanged += OnSidebarStateChanged;
    }

    private void OnSidebarStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void CloseMobileSidebar()
    {
        SidebarService.Close();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUri = e.Location;
        SidebarService.Close(); // Auto-close drawer on route change
        StateHasChanged();
    }

    private bool IsPharmacist => currentRole == "Pharmacist";

    private bool IsDoctor => currentRole == "Doctor";

    private bool IsAdmin => currentRole == "Admin";

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        SidebarService.OnStateChanged -= OnSidebarStateChanged;
    }
}
